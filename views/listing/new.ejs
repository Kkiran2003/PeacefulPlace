
<% layout("/layouts/boilerplate") -%>
<body>
    <h3>add your place</h3>
    <form method="post" action="/new">
    <input type="text" name="list[title]" placeholder="place name"><br/>
    <br/>
    <textarea type="text" cols="55" rows="6" name="list[description]" placeholder="description "></textarea><br/>
    <br/>

    <input type="text" name="list[image.url]" placeholder="image url"><br/>
    <br />
    <input type="number" name="list[price]" placeholder="price"><br/>
    <br/>
    <input type="text" name="list[location]" placeholder="location"><br/>
    <br/>
    <input type="text" name="list[country]" placeholder="country name"><br/>
    <br/>
    <button>Add place</button>
    </form>
</body>
