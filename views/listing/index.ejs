
<% layout("/layouts/boilerplate") -%>
<body >
  <style>
    .nav-filter{
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
    }
    #filters{
      display: flex;
      overflow:auto;
      margin-top: 1rem; 
    }

    .filter{
      text-align: center;
      padding:0px 10px;
      opacity: 0.7;
    }

     .switch{
      text-align: center;
      height: 40px;
      padding:0px 10px 0px 0px;
      border: 1px solid #c1c1c1;
      border-radius: 15px;
    }

    .filter p{
      font-size: small;
    }

    .filter:hover{
      opacity: 1;
      cursor: pointer;
    }

    .tax-info{
      display: none;
    }
  </style>
 
    <div class="nav-filter">
   <div id="filters">
      <div class="filter">
        <div><i class="fa-solid fa-fire-flame-curved"></i></div>
        <p>trending</p>
      </div>
         <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>rooms</p>
      </div>
         <div class="filter">
        <div><i class="fa-solid fa-mountain-sun"></i></div>
        <p>mountain</p>
      </div>
         <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></i></div>
        <p>Amazing pool</p>
      </div>
         <div class="filter">
        <div><i class="fa-solid fa-water"></i></div>
        <p>Surfing</p>
      </div>
         <div class="filter">
        <div><i class="fa-solid fa-umbrella-beach"></i></i></div>
        <p>Beach</p>
      </div>
         <div class="filter">
        <div><i class="fa-solid fa-tractor"></i></i></div>
        <p>Farms</p>
      </div>
   </div>
      <div class="form-check-reverse form-switch" id="filters">
        <div class="switch">
      <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
      <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
      </div>
    </div>
   </div>

 <% console.log(searchTerm) %>

  <div class="all-cards">
   <% for(listing of alllistings){ %>
       <% 
       let tax = listing.price * 0.18;
       let total = listing.price + tax;
    %>

    
    <div class="card list-card">
      <a  href="/listing/<%=listing._id %>" class="card-links" >
          <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
           <div class="card-img-overlay">
  </div>
          <div class="card-body">
            <h6 class="card-text"><b><%= listing.title %></b></h6>
             <p>&#8377;<%= listing.price %>/Night   <i class="tax-info">
                        +18% GST = &#8377;<%= tax %>
                        <br>
                        Total = &#8377;<%= total %>
                    </i></p>
            
          </div>
       </a>    
    </div>
  <%  } %>
 
 </div>
 </div>
 </div>
</body>

<script>
  let pricetax = document.getElementById("flexSwitchCheckDefault");
  pricetax.addEventListener("click",()=>{
    let taxinfo = document.getElementsByClassName("tax-info");
    for(info of taxinfo){
     if(info.style.display != "inline"){
      info.style.display = "inline"
    }else{
      info.style.display = "none"
    }
  }})
</script>
 
  
