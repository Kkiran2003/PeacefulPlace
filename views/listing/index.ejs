
<% layout("/layouts/boilerplate") -%>
<body >
  <div>
    <div class="page-header">
       <h3>Popular Places in world</h3>
  <form method="get" action="/create">
    <button class="add-btn">Add Your Place</button>
  </form>
    </div>
 
  <div class="all-cards">
   <% for(listing of alllistings){ %>
    <div class="card">
      <a  href="/listing/<%=listing._id %>" class="card-links" >
          <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
           <div class="card-img-overlay">
  </div>
          <div class="card-body">
            <h6 class="card-text"><b><%= listing.title %></b></h6>
             <p>&#8377;<%= listing.price %>/Night</p>
          </div>
       </a>    
    </div>
  <%  } %>
 
 </div>
 </div>
 </div>
</body>
 
  
