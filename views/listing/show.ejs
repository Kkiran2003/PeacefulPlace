<% layout("/layouts/boilerplate") -%>
<body>
  <div class="flex col-8 offset-2">
    <div class="card">
        
      <img
        src="<%= list.image.url %>"
        alt="none"
        loading="lazy"
        width="50%"
        height="100%"
        style="border-radius: 12px"
      />
      
      <h4><%= list?.title %></h4>
      <p><%= list?.description %></p>
      <p>Price : &#8377;<%= list?.price.toLocaleString("en-In") %></p>
      <p>location : <%= list.location %></p>
      <p>country : <%= list.country %></p>
    </div>

   <div class="d-flex gap-2">
    <a href="/listing/<%= list._id %>/edit" class="edit-btn edit-btnn">Edit</a>

    <form method="post" action="/delete/<%= list._id %>?_method=delete">
        <button class="btn btn-danger">Delete</button>
    </form>
</div>
      
    
  </div>
</body>
