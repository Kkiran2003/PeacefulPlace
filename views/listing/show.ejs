<% layout("/layouts/boilerplate") -%>
<script>
    let mapToken = "<%= process.env.MAP_TOKEN %>"
    let listing = <%- JSON.stringify(list) %>
</script>
<body>
  <div class="flex col-8 offset-2">
    <h4><%= list?.title %></h4>
    <div class="card list-card">
        
      <img
        src="<%= list.image.url %>"
        alt="none"
        loading="lazy"
        width="50%"
        height="100%"
        style="border-radius: 12px"
      />
      
      <p><b>Owned by : </b><i><%= list.owener.username %></i></p>
      <p><%= list?.description %></p>
      <p>Price : &#8377;<%= list?.price?.toLocaleString("en-In") %></p>
      <p>location : <%= list.location %></p>
      <p>country : <%= list.country %></p>
    </div>


    <% if(currUser && list.owener._id.equals(currUser._id)) { %>
   <div class="d-flex gap-2">
    <a href="/listing/<%= list._id %>/edit" class="edit-btn edit-btnn">Edit</a>

    <form method="post" action="/listing/delete/<%= list._id %>?_method=delete" >
        <button class="btn btn-danger">Delete</button>
    </form>
</div>
<% } %>

<hr>
<div class="mt-3 mb-4">
  <% if(currUser) { %>
  <h4>Leave a Review</h4>
  <form action="/<%= list._id %>/reviews" method="post" class="needs-validation" novalidate>
      <label for="rating" class="form-label">Rating</label> 
    <fieldset class="starability-fade">
      <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
      <input type="radio" id="first-rate1" name="review[rating]" value="1" />
      <label for="first-rate1" title="Terrible">1 star</label>
      <input type="radio" id="first-rate2" name="review[rating]" value="2" />
      <label for="first-rate2" title="Not good">2 stars</label>
      <input type="radio" id="first-rate3" name="review[rating]" value="3" />
      <label for="first-rate3" title="Average">3 stars</label>
      <input type="radio" id="first-rate4" name="review[rating]" value="4" />
      <label for="first-rate4" title="Very good">4 stars</label>
      <input type="radio" id="first-rate5" name="review[rating]" value="5" />
      <label for="first-rate5" title="Amazing">5 stars</label>
    </fieldset>
    <div class="mb-3 mt-3">
      <label for="comment" class="form-label required">Comment</label>
      <textarea name="review[comment]" id="comment" cols="50" rows="5" class="form-control" required></textarea>
      <div class="invalid-feedback">Please add a comment.</div>
    </div>
    <button class="btnn btn-outline-dark">sumbit</button>
  </form>
  <% } %>
</div>
<% if(list.reviews.length > 0) { %>
  <p><b>recent Reviews</b></p>
<% } %>
<div class="row">
  <% for (review of list.reviews) { %>
  <div class="card col-5 mb-3 ms-3 p-2">
    <div class="card-body">
    <P><b>@<%=review.author.username %> </b></P>
    <p class="starability-result" data-rating="<%= review.rating %>">
    <p> <%=review.comment %></p>
  </p>
  </div>
  <% if(currUser) { %>
  <form  method="Post" action="/<%= list._id%>/reviews/<%= review._id %>?_method=delete">
    <button class=" btn btn-dark">Delete</button>
  </form>
  <% } %>
</div>
<%}%>
</div>

<h3>where you'll find</h3>
<div id="map">
</div>
</div>
<script src="/js/map.js"></script>
</body>
